diff --git a/bsd/dev/herolte_touch.c b/bsd/dev/herolte_touch.c
index 9ff610a..cf0dc71 100644
--- a/bsd/dev/herolte_touch.c
+++ b/bsd/dev/herolte_touch.c
@@ -796,6 +796,15 @@ herolte_touch_probe(void)
 	int enabled = 1;
 	thread_t thread;
 
+#if defined(ARM64_BOARD_CONFIG_HERO2LTE)
+	/*
+	 * SM-G935F: the DTB disables touchscreen@48 (sec_ts) and enables an STM FTS
+	 * at 0x49 with its IRQ on GPA2-0. This file only speaks sec_ts, so touch
+	 * stays off here until an FTS driver exists (HERO2LTE_PROGRESS.md).
+	 */
+	printf("HERO2LTE TOUCH: STM FTS (0x49, GPA2-0) not implemented; sec_ts probe skipped\n");
+	return;
+#endif
 	PE_parse_boot_argn("herotouch", &enabled, sizeof(enabled));
 	if (!enabled) {
 		printf("HEROLTE TOUCH: disabled\n");
