+MACHINE_FLAGS_ARM64_HERO2LTE = -DARM64_BOARD_CONFIG_A5XELTE -DARM64_BOARD_CONFIG_HEROLTE -DARM64_BOARD_CONFIG_HERO2LTE -mcpu=cortex-a53 -march=armv8-a+crypto
 
 
